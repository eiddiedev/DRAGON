+   local sx=math.max(.0001,math.abs(rt.lossyScale.x));local sy=math.max(.0001,math.abs(rt.lossyScale.y))
+   rt:SetSizeWithCurrentAnchors(U.RectTransform.Axis.Horizontal,p.size/sx)
