+-- review-v28: presentation teardown owns only its title camera and input lease.
+-- Normal book/map completion already releases both; repeated teardown is a no-op.
+function UI.releasePresentation()
+    UI.camEnd()
+    UI.releasePlayerLock(nil)
+end
+UI.v28PresentationDisable = OnDisable
+UI.v28PresentationDestroy = OnDestroy
+function OnDisable()
+    UI.releasePresentation()
+    if UI.v28PresentationDisable then UI.v28PresentationDisable() end
+end
+function OnDestroy()
+    UI.releasePresentation()
+    if UI.v28PresentationDestroy then UI.v28PresentationDestroy() end
+end
