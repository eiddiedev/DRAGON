+-- Only this presentation layer's input lease may be released here. The platform
+-- does not expose a lock-owner getter, so known riding/battle handoffs stay owned
+-- by their own controllers; this script never calls StopFly/StandUp to steal them.
+function UI.foreignInputOwner(actor, lease)
+    local ok, occupied = pcall(function()
+        if DR.rider == actor or actor:IsSitting() or actor:IsFlying() then return true end
+        if lease and actor.gameObject.transform.parent ~= lease.parent then return true end
+        local phase = DR.phase1
+        local battle = phase and phase.scope and phase.scope:GetScript('dragon_combat.lua')
+        if battle then
+            if battle.IsParticipating() then return true end
+            local status = battle.GetStatus()
+            if status and status.member and status.phase == 'ready' then return true end
+        end
+        return false
+    end)
+    -- A teardown query failure is not permission to unlock another controller.
+    return not ok or occupied == true
+end
+function UI.releasePlayerLock(actor)
+    local lease = UI.inputLease
+    if not lease or (actor and lease.actor ~= actor) then return false end
+    UI.inputLease = nil
+    if UI.foreignInputOwner(lease.actor, lease) then return false end
+    local released = pcall(function() lease.actor:Immobilize(false) end)
+    if released and lease.hidden then
+        pcall(function() DouyinUIService.SetUIVisible(true) end)
+        pcall(function() DouyinUIService.SetNativeUIVisible(true) end)
+    end
+    return released
+end
